{
  "multipart": [
    {
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_magenta_hub"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_magenta_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_magenta_up"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_magenta_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_magenta_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_magenta_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_magenta_side",
        "y": 270
      }
    }
  ]
}
