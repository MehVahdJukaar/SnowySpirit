{
  "multipart": [
    {
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_black_hub"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_black_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_black_up"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_black_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_black_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_black_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "snowyspirit:block/roped_glow_lights_black_side",
        "y": 270
      }
    }
  ]
}
